{
  "name": "hermiq",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test:l10n": "node tests/l10n/check-l10n.js",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "stylelint-fix": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "check:manifest": "node tests/validate-manifest.js",
    "check:manifest-v2": "node tests/manifest-v2.spec.js",
    "check:register": "node tests/validate-register.js",
    "check:registry": "node tests/registry.spec.js",
    "check:agent-context": "node tests/agent-context.spec.js",
    "check:json-strict": "node tests/validate-json-strict.js",
    "check:specs": "npm run check:json-strict && npm run check:manifest-v2 && npm run check:register && npm run check:registry && npm run check:agent-context && npm run check:flow-branches && npm run check:flow-trigger-count",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:flow-branches": "node tests/flow-branches.spec.js",
    "check:flow-trigger-count": "node tests/flow-trigger-count.spec.js",
    "icons:opengemeenten": "node scripts/generate-opengemeenten-icons.mjs"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@conduction/nextcloud-vue": "2.2.0-vue3.16",
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/dialogs": "^6.0.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@opengemeenten/iconset-web-component": "^2.0.0",
    "babel-loader": "^10.1.1",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.11",
    "gridstack": "^12.0.0",
    "marked": "^15.0.12",
    "node-polyfill-webpack-plugin": "4.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "vue3-apexcharts": "1.8.0",
    "libxmljs2": "^0.37.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/vue": "^9.9.0",
    "@nextcloud/dialogs": {
      "@vueuse/core": "11.3.0"
    },
    "eslint-import-resolver-typescript": "~3.8.7",
    "eslint-plugin-import-x": {
      "@typescript-eslint/utils": "^7.18.0"
    },
    "@toast-ui/editor": {
      "dompurify": "^3.4.13"
    }
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@eslint/config-helpers": "^0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^6.0.1",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "css-loader": "~7.1.1",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "~3.8.7",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.21.1",
    "postcss-html": "^1.8.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "~4.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  }
}
