test-results/**/*.jpeg
test-results/**/*.gif
test-results/**/*.webp
openspec/test-site-results/**/*.png
openspec/test-site-results/**/*.jpg
openspec/test-site-results/**/*.jpeg
openspec/test-site-results/**/*.gif
openspec/test-site-results/**/*.webp

# SBOM is published as release asset (see SECURITY.md), not stored in repo
sbom.cdx.json
bom-php.cdx.json
bom-npm.cdx.json
composer.phar

# A stray older copy of src/views/Chat.vue that lived untracked in the working
# tree. It is NOT the file the app loads (src/registry.js imports
# ./views/Chat.vue), it lacks the e2e data-testid and the prefers-reduced-motion
# block the real one has, and its relative imports do not resolve from src/ —
# which is what broke eslint the moment it was accidentally committed.
/src/Chat.vue

# Operator secrets. `exapp/*/deploy/.env` carries APP_SECRET — the 128-char
# value Nextcloud mints when an ExApp registers. It is required to start the
# runner and must never reach the repository: it is a live credential for an
# app that executes vendor LLM CLIs.
.env
*/.env
**/deploy/.env

# Agent/test scratch and tool caches — generated, never source.
# Added by the 2026-08-25 fleet hygiene sweep (ADR-100 Decision 2).
.stale/
/.e2e-state/
