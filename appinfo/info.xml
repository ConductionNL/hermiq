    <!-- @spec openspec/architecture/adr-023-action-authorization.md -->
    <!--
      NC's info.xml <dependencies> has no element to pin the version of another
      Nextcloud app (only php/nextcloud/database/lib/architecture/backend — see
      resources/app-info.xsd upstream); an inter-Conduction-app version floor like
      "OpenRegister >= 0.2.17-unstable.14" cannot be expressed/enforced there. The
      requirement is documented in <description> above; CheckOpenRegisterCompatibility
      below is the enforceable half — it runs class_exists() on the two classes the
      agent engine hard-depends on and logs a clear, actionable warning/error instead
      of letting AgentsController/Engine/ToolLoop fail construction with a bare
      ReflectionException on a stale-OpenRegister fleet instance.
    -->
    <repair-steps>
        <install>
            <step>OCA\Hermiq\Repair\CheckOpenRegisterCompatibility</step>
            <step>OCA\Hermiq\Repair\InitializeSettings</step>
            <step>OCA\Hermiq\Repair\InitializeActions</step>
            <step>OCA\Hermiq\Repair\SeedAiFeatures</step>
            <step>OCA\Hermiq\Repair\SeedBudgets</step>
            <step>OCA\Hermiq\Repair\SeedModelPolicies</step>
            <step>OCA\Hermiq\Repair\SeedIncidents</step>
            <step>OCA\Hermiq\Repair\SeedCourseRecommendationFeature</step>
            <step>OCA\Hermiq\Repair\SeedComplianceControls</step>
            <step>OCA\Hermiq\Repair\SeedAgentTemplates</step>
            <step>OCA\Hermiq\Repair\SeedSkillCreator</step>
            <step>OCA\Hermiq\Repair\SeedMaturityExampleSkills</step>
            <step>OCA\Hermiq\Repair\SeedPairedEvalDataset</step>
            <step>OCA\Hermiq\Repair\SeedSkillDraftExample</step>
            <!-- @spec openspec/changes/hydra-console-agent-leaves/tasks.md#task-7-seed-the-triage-agentflow -->
            <!-- Flow BEFORE agent: the agent step names the agent, so seeding the
                 flow first means an operator enabling it finds the agent already
                 there. Both are idempotent by name, so the order only affects a
                 first install. -->
            <step>OCA\Hermiq\Repair\SeedHydraTriageFlow</step>
            <!-- @spec openspec/changes/hydra-console-agent-leaves/tasks.md#task-6-seed-the-hydra-triage-agent -->
            <step>OCA\Hermiq\Repair\SeedHydraTriageAgent</step>
            <!-- @spec openspec/changes/talk-chat-bridge/tasks.md#1-bot-registration-and-lifecycle -->
            <step>OCA\Hermiq\Repair\InstallTalkBot</step>
        </install>
        <post-migration>
            <step>OCA\Hermiq\Repair\CheckOpenRegisterCompatibility</step>
            <step>OCA\Hermiq\Repair\InitializeSettings</step>
            <step>OCA\Hermiq\Repair\InitializeActions</step>
            <step>OCA\Hermiq\Repair\SeedAiFeatures</step>
            <step>OCA\Hermiq\Repair\SeedBudgets</step>
            <step>OCA\Hermiq\Repair\SeedModelPolicies</step>
            <step>OCA\Hermiq\Repair\SeedIncidents</step>
            <step>OCA\Hermiq\Repair\SeedCourseRecommendationFeature</step>
            <step>OCA\Hermiq\Repair\SeedComplianceControls</step>
            <step>OCA\Hermiq\Repair\SeedAgentTemplates</step>
            <step>OCA\Hermiq\Repair\SeedSkillCreator</step>
            <step>OCA\Hermiq\Repair\SeedMaturityExampleSkills</step>
            <step>OCA\Hermiq\Repair\SeedPairedEvalDataset</step>
            <step>OCA\Hermiq\Repair\SeedSkillDraftExample</step>
            <!-- @spec openspec/changes/hydra-console-agent-leaves/tasks.md#task-7-seed-the-triage-agentflow -->
            <!-- Flow BEFORE agent: the agent step names the agent, so seeding the
                 flow first means an operator enabling it finds the agent already
                 there. Both are idempotent by name, so the order only affects a
                 first install. -->
            <step>OCA\Hermiq\Repair\SeedHydraTriageFlow</step>
            <!-- @spec openspec/changes/hydra-console-agent-leaves/tasks.md#task-6-seed-the-hydra-triage-agent -->
            <step>OCA\Hermiq\Repair\SeedHydraTriageAgent</step>
            <step>OCA\Hermiq\Repair\MigrateAgentData</step>
            <step>OCA\Hermiq\Repair\RemoveLegacyLlmKeys</step>
            <!-- @spec openspec/changes/talk-chat-bridge/tasks.md#1-bot-registration-and-lifecycle -->
            <!-- Registers the in-process Talk bot. A no-op when Talk is absent,
                 and activates nothing on its own: a Talk moderator must still
                 enable it per conversation AND the agent must be Talk-enabled. -->
            <step>OCA\Hermiq\Repair\InstallTalkBot</step>
        </post-migration>
    </repair-steps>

    <settings>
        <admin>OCA\Hermiq\Settings\AdminSettings</admin>
        <admin-section>OCA\Hermiq\Sections\SettingsSection</admin-section>
    </settings>

    <!-- @spec openspec/changes/agent-schedule-dispatcher/tasks.md#task-1-2 -->
    <!-- @spec openspec/changes/skills-marketplace/tasks.md#task-3-1 -->
    <!-- Single <background-jobs> block only — a second block causes an NC upgrade 500. -->
    <background-jobs>
        <job>OCA\Hermiq\Cron\ScheduleTask</job>
        <job>OCA\Hermiq\Cron\SkillCuratorTask</job>
        <job>OCA\Hermiq\Cron\SkillLearningsPromotionTask</job>
        <job>OCA\Hermiq\Cron\SkillConsolidationTask</job>
    </background-jobs>
</info>
