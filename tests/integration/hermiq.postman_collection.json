{
	"info": {
		"_postman_id": "hermiq-collection",
		"name": "Hermiq Integration Tests",
		"description": "Integration test collection for the hermiq Nextcloud app.\nReplace this with your actual API tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{admin_user}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{admin_password}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "admin_user",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "admin_password",
			"value": "admin",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Nextcloud status",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/status.php",
						"description": "Verify Nextcloud is running."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Nextcloud is running', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.installed).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Run comparison",
			"item": [
				{
					"name": "Compare two runs that do not exist",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							}
						],
						"url": "{{base_url}}/index.php/apps/hermiq/api/runs/compare?left=no-such-run&right=no-such-run-either",
						"description": "REQ-RCMP-001: a run the caller may not see is answered like a run that does not exist (404 per side)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Both sides are not found', function () {",
									"    pm.response.to.have.status(404);",
									"    pm.expect(pm.response.json().missing).to.eql(['left', 'right']);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Record summary",
			"item": [
				{
					"name": "Summary status without a record reference",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/index.php/apps/hermiq/api/assistant/summary",
						"description": "REQ-APPAG-004: the leaf must name the record."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('A missing reference is refused', function () {",
									"    pm.response.to.have.status(400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Summary status of a record that does not exist",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/index.php/apps/hermiq/api/assistant/summary?register=hermiq&schema=agentassistantprompt&objectId=no-such-record",
						"description": "REQ-APPAG-004: a record the caller cannot read is answered as not found, before any agent or model."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('The record is not found', function () {",
									"    pm.response.to.have.status(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Summarise a record that does not exist",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/index.php/apps/hermiq/api/assistant/summarise",
						"description": "REQ-APPAG-004 scenario: no summary for a record the user cannot read (404, no model call).",
						"body": {
							"mode": "raw",
							"raw": "{\"register\": \"hermiq\", \"schema\": \"agentassistantprompt\", \"objectId\": \"no-such-record\"}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('The record is not found', function () {",
									"    pm.response.to.have.status(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Create a record to summarise",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/index.php/apps/openregister/api/objects/hermiq/agentassistantprompt",
						"description": "A record the admin can read: one assistant prompt, deleted again at the end of this folder.",
						"body": {
							"mode": "raw",
							"raw": "{\"label\": \"Newman record summary probe\", \"prompt\": \"A record for the summary endpoints.\", \"enabled\": false}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('The record is created', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"    const body = pm.response.json();",
									"    const id = body.id || body.uuid || (body['@self'] || {}).id;",
									"    pm.expect(id).to.be.a('string');",
									"    pm.collectionVariables.set('summary_record', id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Summary status of a readable record",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/index.php/apps/hermiq/api/assistant/summary?register=hermiq&schema=agentassistantprompt&objectId={{summary_record}}",
						"description": "REQ-APPAG-004: a readable record answers 200 with what the leaf may show. The record-summary feature is seeded disabled, so no agent is offered and nothing is stored."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('The status is answered', function () {",
									"    pm.response.to.have.status(200);",
									"    const body = pm.response.json();",
									"    pm.expect(body.enabled).to.eql(false);",
									"    pm.expect(body.agent).to.eql(null);",
									"    pm.expect(body.summary).to.eql(null);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Summarise while the feature is off",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/index.php/apps/hermiq/api/assistant/summarise",
						"description": "REQ-APPAG-004: off when the organisation has not enabled the record-summary AI feature (403, no model call).",
						"body": {
							"mode": "raw",
							"raw": "{\"register\": \"hermiq\", \"schema\": \"agentassistantprompt\", \"objectId\": \"{{summary_record}}\"}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('The feature is off', function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Delete the record",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "OCS-APIREQUEST",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/index.php/apps/openregister/api/objects/hermiq/agentassistantprompt/{{summary_record}}",
						"description": "Clean up the probe record."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('The record is deleted', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		}
	]
}
