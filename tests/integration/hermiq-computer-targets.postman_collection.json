            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/index.php/apps/hermiq/api/settings/computer-targets"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"source\": \"00000000-0000-0000-0000-000000000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 without a name', () => pm.response.to.have.status(400));",
              "pm.test('the refusal names the name', () => pm.expect(pm.response.text()).to.include('A computer target needs a name.'));"
            ]
          }
        }
      ]
    },
