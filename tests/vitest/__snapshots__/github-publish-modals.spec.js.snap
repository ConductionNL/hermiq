// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AgentTemplatePublishModal > publishes privately by default and shows a failure 1`] = `
"<nc-modal data-v-9543a063="">
  <div data-v-9543a063="" class="agent-template-publish-modal">
    <h3 data-v-9543a063="">Publish to GitHub</h3>
    <!--v-if-->
    <nc-textfield data-v-9543a063="" data-modelvalue="acme" data-label="Owner" data-placeholder="e.g. acme-council"></nc-textfield>
    <nc-textfield data-v-9543a063="" data-modelvalue="repo" data-label="Repository name" data-placeholder="e.g. morning-briefing-template"></nc-textfield>
    <nc-select data-v-9543a063="" data-modelvalue="{&quot;label&quot;:&quot;Private&quot;,&quot;value&quot;:&quot;private&quot;}" data-options="[{&quot;label&quot;:&quot;Private&quot;,&quot;value&quot;:&quot;private&quot;},{&quot;label&quot;:&quot;Public&quot;,&quot;value&quot;:&quot;public&quot;}]" data-inputlabel="Visibility" data-clearable="false" data-label="label" data-trackby="value"></nc-select>
    <nc-select data-v-9543a063="" data-modelvalue="{&quot;value&quot;:&quot;c-3&quot;}" data-options="[{&quot;label&quot;:&quot;Mine&quot;,&quot;value&quot;:&quot;c-1&quot;},{&quot;label&quot;:&quot;c-3&quot;,&quot;value&quot;:&quot;c-3&quot;}]" data-inputlabel="GitHub credential" data-loading="false" data-placeholder="Select a credential" data-label="label"></nc-select>
    <!--v-if-->
    <nc-button data-v-9543a063="" data-type="primary" data-disabled="true">Publishing…</nc-button>
  </div>
</nc-modal>"
`;

