exports[`AgentTemplatePublishModal > shows the hint when the credentials cannot be read 1`] = `
"<nc-modal data-v-9543a063="">
  <div data-v-9543a063="" class="agent-template-publish-modal">
    <h3 data-v-9543a063="">Publish to GitHub</h3>
    <!--v-if-->
    <nc-textfield data-v-9543a063="" data-modelvalue="" data-label="Owner" data-placeholder="e.g. acme-council"></nc-textfield>
    <nc-textfield data-v-9543a063="" data-modelvalue="" data-label="Repository name" data-placeholder="e.g. morning-briefing-template"></nc-textfield>
    <nc-select data-v-9543a063="" data-modelvalue="{&quot;label&quot;:&quot;Private&quot;,&quot;value&quot;:&quot;private&quot;}" data-options="[{&quot;label&quot;:&quot;Private&quot;,&quot;value&quot;:&quot;private&quot;},{&quot;label&quot;:&quot;Public&quot;,&quot;value&quot;:&quot;public&quot;}]" data-inputlabel="Visibility" data-clearable="false" data-label="label" data-trackby="value"></nc-select>
    <nc-select data-v-9543a063="" data-modelvalue="null" data-options="[]" data-inputlabel="GitHub credential" data-loading="false" data-placeholder="Select a credential" data-label="label"></nc-select>
    <p data-v-9543a063="" class="agent-template-publish-modal__hint">No GitHub credential yet. Add a personal one under your Personal settings, or ask an organisation admin to add one under the Hermiq admin settings, then reopen this dialog.</p>
    <nc-button data-v-9543a063="" data-type="primary" data-disabled="true">Publish</nc-button>
  </div>
</nc-modal>"
`;

