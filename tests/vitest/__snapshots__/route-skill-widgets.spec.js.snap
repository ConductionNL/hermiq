// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SkillLearnings > holds no skill when the store has none 1`] = `
"<div data-v-3cd7e60c="" class="skill-learnings">
  <!--v-if-->
  <p data-v-3cd7e60c="" class="skill-learnings__empty">No learnings yet. Once agents run with this skill, observations are captured automatically and confirmed ones are promoted here.</p>
</div>"
`;

exports[`SkillLearnings > registers the skill type and loads the route skill 1`] = `
"<div data-v-3cd7e60c="" class="skill-learnings">
  <!--v-if-->
  <nc-loadingicon data-v-3cd7e60c="" data-size="24" data-class="skill-learnings__loading"></nc-loadingicon>
</div>"
`;

exports[`SkillLearnings > registers the skill type and loads the route skill 2`] = `
"<div data-v-3cd7e60c="" class="skill-learnings">
  <!--v-if-->
  <dl data-v-3cd7e60c="" class="skill-learnings__facts">
    <div data-v-3cd7e60c="" class="skill-learnings__fact">
      <dt data-v-3cd7e60c="">Promoted learnings</dt>
      <dd data-v-3cd7e60c="">—</dd>
    </div>
    <div data-v-3cd7e60c="" class="skill-learnings__fact">
      <dt data-v-3cd7e60c="">Open candidates</dt>
      <dd data-v-3cd7e60c="">—</dd>
    </div>
    <div data-v-3cd7e60c="" class="skill-learnings__fact">
      <dt data-v-3cd7e60c="">Last capture</dt>
      <dd data-v-3cd7e60c="">1/2/2026, 3:04:05 AM</dd>
    </div>
    <div data-v-3cd7e60c="" class="skill-learnings__fact">
      <dt data-v-3cd7e60c="">Last promotion</dt>
      <dd data-v-3cd7e60c="">—</dd>
    </div>
  </dl><!-- Learnings markdown is sanitised via DOMPurify with the shared safe config. -->
  <!-- eslint-disable-next-line vue/no-v-html -->
  <div data-v-3cd7e60c="" class="skill-learnings__content">
    <h1>Learned</h1>
  </div>
  <p data-v-3cd7e60c="" class="skill-learnings__hint">Learnings are captured automatically after runs that used this skill and promoted by a daily background pass. This view is read-only.</p>
</div>"
`;

exports[`SkillLearnings > reports a failed fetch ({"response":{"data":{"error":"Not allowed"}},"message":"Request failed"}) 1`] = `
